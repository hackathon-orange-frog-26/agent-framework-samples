FOUNDRY_PROJECT_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_MODEL_DEPLOYMENT=gpt-5.3-codex-2
# Existing Work IQ MCP connection in this project; no secrets or tokens here.
WORKIQ_CONNECTION_NAME=workshop-workiq-mcp
# app.deploy resolves the connection ID and passes it to the hosted runtime.
# Target subscription, not necessarily the Foundry project's subscription.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP_PREFIX=mea-agent-
AZURE_RESOURCE_GROUP_LOCATION=eastus
